@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Delivery Order',
    typeNamePlural: 'Delivery Orders',
    title: {
      type: #STANDARD,
      label: 'Delivery Order',
      value: 'DeliveryNo'
    },
    description: {
      value: 'CustomerName'
    }
  },
  presentationVariant: [{
    sortOrder: [{
      by: 'DeliveryNo',
      direction: #ASC
    }],
    visualizations: [{
      type: #AS_LINEITEM
    }]
  }]
}
annotate view ZCPT_C_DLV with
{
  @UI.facet: [
    {
      id: 'DeliveryGeneral',
      type: #COLLECTION,
      label: 'Delivery Information',
      position: 10
    },
    {
      id: 'DeliveryIdentification',
      parentId: 'DeliveryGeneral',
      type: #IDENTIFICATION_REFERENCE,
      label: 'General Data',
      position: 10
    }
  ]

  @UI.hidden: true
  UUID;

  @EndUserText.label: 'Delivery Order'
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @Search.defaultSearchElement: true
  DeliveryNo;

  @EndUserText.label: 'Customer'
  @EndUserText.quickInfo: 'Name of the customer receiving the delivery'
  @Search.defaultSearchElement: true
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  CustomerName;

  @EndUserText.label: 'Planned Date'
  @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
  @UI.selectionField: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  PlannedDate;

  @EndUserText.label: 'Status'
  @UI.lineItem: [
    { position: 40, importance: #HIGH },
    { type: #FOR_ACTION, dataAction: 'setReady', label: 'Mark Ready', position: 50 },
    { type: #FOR_ACTION, dataAction: 'setShipped', label: 'Mark Shipped', position: 60 }
  ]
  @UI.selectionField: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Status;

  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  LocalChgAt;
}
