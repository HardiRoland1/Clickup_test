@Metadata.layer: #CORE
annotate entity ZCPT_C_DLV with
{
  @UI.hidden: true
  UUID;

  @EndUserText.label: 'Delivery Order'
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  DeliveryNo;

  @EndUserText.label: 'Customer'
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  CustomerName;

  @EndUserText.label: 'Planned Date'
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  PlannedDate;

  @EndUserText.label: 'Status'
  @UI.lineItem: [
    { position: 40 },
    { type: #FOR_ACTION, dataAction: 'setReady', label: 'Mark Ready', position: 50 },
    { type: #FOR_ACTION, dataAction: 'setShipped', label: 'Mark Shipped', position: 60 }
  ]
  @UI.identification: [{ position: 40 }]
  @UI.selectionField: [{ position: 40 }]
  Status;
}
