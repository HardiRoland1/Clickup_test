managed implementation in class ZBP_CPT_DLV unique;
strict ( 2 );

define behavior for ZCPT_R_DLV alias Root
persistent table ZCPT_D_DLV
lock master
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) UUID;
  field ( readonly ) Status;
  field ( mandatory ) DeliveryNo, CustomerName, PlannedDate;

  determination initStatus on modify { create; }
  action setReady;
  action setShipped;
}
