projection;
strict ( 2 );

define behavior for ZCPT_C_DLV alias DeliveryOrder
use etag
{
  use create;
  use update;
  use delete;
  use action setReady;
  use action setShipped;
  use association _Items { create; }
}

define behavior for ZCPT_C_ITM alias DeliveryItem
use etag
{
  use update;
  use delete;
  use association _DeliveryOrder;
}
