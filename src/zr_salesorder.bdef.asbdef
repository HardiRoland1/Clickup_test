managed implementation in class zbp_r_salesorder unique;
strict ( 2 );

define behavior for ZR_SALESORDER alias SalesOrder
persistent table zso_salesorder
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) SalesOrderUUID;
  field ( readonly ) SalesOrderID, CreatedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) CustomerName;

  determination setDefaults on save { create; }

  mapping for zso_salesorder
  {
    SalesOrderUUID     = sales_order_uuid;
    SalesOrderID       = sales_order_id;
    CustomerName       = customer_name;
    OrderDate          = order_date;
    NetAmount          = net_amount;
    CurrencyCode       = currency_code;
    OverallStatus      = overall_status;
    CreatedBy          = created_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
